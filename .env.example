# 可选配置；直接 docker compose up -d 即可启动。
# 用户名和密码首次在网页设置；无需提前生成内部 Token。
HUB_PORT=9985
HUB_BIND_ADDRESS=0.0.0.0
HUB_AUTH_REQUIRED=true
HUB_COOKIE_SECURE=false
# 默认音乐目录；NAS 用户改为自己的宿主机绝对路径。
ENGINE_DOWNLOAD_PATH=./data/music
# 以下默认使用 Docker 命名卷；旧版升级保留旧 .env 中的绑定路径。
HUB_TASKS_PATH=hub_tasks
ENGINE_DATA_PATH=engine_data
# 可选镜像源，按实际网络选择。
ENGINE_GOPROXY=https://proxy.golang.org,direct
# Docker Hub；也可改用 ghcr.io/io-aoleo/music-hub:latest
# 固定版本示例：ioaoleo/music-hub:1.0.0
MUSIC_HUB_IMAGE=ioaoleo/music-hub:latest
# 仅旧版迁移可用；新安装保持空值。
HUB_USER=admin
HUB_PASSWORD=
HUB_ENGINE_TOKEN=
